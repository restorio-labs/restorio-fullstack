{
  "name": "restorio-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app/apps/*",
    "app/packages/*"
  ],
  "scripts": {
    "dev": "turbo run build --filter='./app/packages/*' && turbo run dev --concurrency=100%",
    "dev:kitchen-panel": "turbo run build --filter='@restorio/kitchen-panel...' && turbo run dev --concurrency=100% --filter='@restorio/kitchen-panel...'",
    "dev:ui-demo": "bun run --filter @restorio/ui-demo demo",
    "build": "turbo run build",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "turbo run clean",
    "check": "prettier --check \"**/*.{ts,tsx,json,md}\" && eslint . --ext ts,tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" && eslint . --fix",
    "coverage:report": "bun run scripts/coverage-report.ts",
    "check:root": "prettier --check \"**/*.{ts,tsx,json,md}\" && eslint . --ext ts,tsx",
    "sync:eslintignore": "for d in app/apps/* app/packages/*; do [ \"$d\" = \"app/apps/api\" ] && continue; cp .eslintignore \"$d/.eslintignore\"; done",
    "sync:prettierignore": "for d in app/apps/* app/packages/*; do [ \"$d\" = \"app/apps/api\" ] && continue; cp .prettierignore \"$d/.prettierignore\"; done",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "packageManager": "bun@1.3.5",
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4",
    "flatted": "3.4.4",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "next": "16.2.11",
    "postcss": "8.5.25",
    "qs": "6.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.2",
    "vite": "8.0.16",
    "ws": "8.21.0",
    "yaml": "2.8.3",
    "@vitejs/plugin-react": "^6.0.1"
  },
  "type": "module"
}
